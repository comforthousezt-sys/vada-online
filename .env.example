PORT=10000
# Повний origin, без /vada чи іншого шляху. www та без www — різні origins.
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Для Render обов'язково задайте DATABASE_URL або явно оберіть режим демо.
DATABASE_URL=
DATABASE_SSL_CA_BASE64=
ALLOW_EPHEMERAL=false
DATA_DIR=./data
TURN_SECONDS=30
PROPOSAL_SECONDS=30
DEBATE_SECONDS=120
VOTE_SECONDS=30
